# ===== WMS AI Platform 环境配置（PRD V2.0 — 无GPU运行 + 商用API + MySQL数据层）=====

# ===== 服务配置 =====
SERVICE_NAME=wms-ai-platform
ENV=development
LOG_LEVEL=INFO

# ===== 中间件配置 =====
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka (KRaft 模式，去 Zookeeper)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=wms-ai-group

# MySQL（PRD V2.0 主数据库 — 知识库/对话/OCR 持久化）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=wms_ai
MYSQL_PASSWORD=wms_password
MYSQL_DATABASE=wms_ai

# Oracle (WMS核心数据库，只读) — @deprecated PRD V2.0 改用 MySQL，保留兼容
ORACLE_DSN=localhost:1521/ORCLPDB1
ORACLE_USER=wms_user
ORACLE_PASSWORD=wms_password

# ClickHouse (OLAP报表/LLM调用日志)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=wms_ai

# MinIO (文件/模型存储)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wms-ai

# Milvus (向量数据库 — 语义缓存 + RAG检索)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== AI模型服务 =====
MODEL_SERVICE_URL=http://localhost:8001
DATA_SERVICE_URL=http://localhost:8002

# DeepSeek LLM（主力商用 API）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-pro
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# GLM LLM（备选 — 主力故障自动切换）
LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_FALLBACK_API_KEY=sk-xxx
LLM_FALLBACK_MODEL=glm-5.2

# SiliconFlow API（Embedding / Rerank / OCR 在线服务统一网关）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-xxx

# Embedding（bge-m3，可独立配置，默认同 SiliconFlow）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Rerank（bge-reranker-v2-m3）
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-xxx
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# OCR Online（SiliconFlow 托管的 DeepSeek-OCR-2）
OCR_ONLINE_BASE_URL=https://api.siliconflow.cn/v1
OCR_ONLINE_API_KEY=sk-xxx
OCR_ONLINE_MODEL=deepseek-ai/DeepSeek-OCR-2

# ASR（SiliconFlow 托管的 XingChenASR-V3.2-Ultra）
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=sk-xxx
ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra

# 模型路由（JSON 字符串，按 task_type 选模型）
MODEL_ROUTE={"rag":"deepseek-v4-pro","nl2sql":"deepseek-v4-pro","ocr_extract":"deepseek-v4-pro","default":"deepseek-v4-pro"}

# TTS
TTS_MODEL=qwen2.5-omni-tts
TTS_VOICE=default
TTS_FORMAT=wav

# ===== 网关 =====
GATEWAY_PORT=8000
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== 模块配置 =====

# 预测
FORECAST_DEFAULT_PERIODS=30
FORECAST_MODEL=prophet
FORECAST_TRAIN_DATA_DAYS=365

# 五级缓存
CACHE_L1_MAX_SIZE=10000
CACHE_L1_TTL=3600
CACHE_L2_TTL=86400
CACHE_L3_TTL=604800
CACHE_L4_TTL=604800
CACHE_L5_TTL=2592000
CACHE_SEMANTIC_THRESHOLD=0.92
CACHE_NL2SQL_THRESHOLD=0.95
CACHE_TTL_JITTER=0.1

# RAG 检索参数
RAG_RETRIEVAL_VECTOR_EF=128
RAG_RETRIEVAL_VECTOR_M=16
RAG_RETRIEVAL_VECTOR_EF_CONSTRUCTION=200
RAG_RETRIEVAL_RRF_K=60
RAG_RETRIEVAL_TOP_K=20
RAG_RETRIEVAL_RERANK_TOP_N=5
RAG_RETRIEVAL_KEYWORD_MODE=bm25

# X WMS Web 后台 Dockerfile
# 多阶段构建: 前端构建 + Nginx运行

# ========== 阶段1: 前端构建 ==========
FROM node:22-alpine AS builder
WORKDIR /build

# 安装 pnpm
RUN npm install -g pnpm@10

# 缓存依赖
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/packages ./packages
COPY frontend/apps/web-admin ./apps/web-admin
RUN pnpm install --frozen-lockfile

# 构建
RUN pnpm --filter @xwms/web-admin build

# ========== 阶段2: Nginx运行 ==========
FROM nginx:1.27-alpine
LABEL maintainer="X WMS Team"
LABEL app="x-wms"
LABEL service="web-admin"

# 时区
RUN apk add --no-cache tzdata curl && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# 复制构建产物
COPY --from=builder /build/apps/web-admin/dist /usr/share/nginx/html

# Nginx配置
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

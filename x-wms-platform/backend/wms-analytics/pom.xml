<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xwms</groupId>
        <artifactId>x-wms-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>wms-analytics</artifactId>
    <name>WMS Analytics Service</name>
    <description>分析服务：KPI报表/经营分析/实时看板/数据归档（ClickHouse OLAP）</description>
    <dependencies>
        <dependency><groupId>com.xwms</groupId><artifactId>wms-common</artifactId><version>${project.version}</version></dependency>
        <!-- Lombok 编译时依赖（wms-common 中为 optional，需各模块显式声明） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency><groupId>com.alibaba.cloud</groupId><artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId></dependency>
        <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka</artifactId></dependency>
        <dependency><groupId>org.redisson</groupId><artifactId>redisson-spring-boot-starter</artifactId></dependency>
        <dependency><groupId>com.yomahub</groupId><artifactId>liteflow-spring-boot-starter</artifactId></dependency>
        <dependency><groupId>com.clickhouse</groupId><artifactId>clickhouse-jdbc</artifactId><classifier>all</classifier></dependency>
        <!-- MySQL JDBC (billing/costing 迁入后需要) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Druid 连接池 (billing/costing 迁入后需要 MySQL datasource) -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build><finalName>wms-analytics</finalName><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>
</project>


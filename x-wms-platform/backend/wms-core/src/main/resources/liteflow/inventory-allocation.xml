<?xml version="1.0" encoding="UTF-8"?>
<flow>
    <!--
        库存分配流程编排
        流程：规则匹配 → 周转排序 → 库位过滤 → 批次过滤 → 可用性检查 → Redis预占 → Oracle预占
    -->

    <chain name="inventoryAllocation">
        THEN(
            allocRuleMatch,
            turnoverSort,
            locationFilter,
            batchFilter,
            availabilityCheck,
            redisReserve,
            oracleReserve
        );
    </chain>

    <!--
        说明：
        1. availabilityCheck失败则中断流程（isContinueOnError=false）
        2. Redis预占和Oracle预占串行执行，保证一致性
        3. 整个流程在事务内执行，失败则回滚
    -->
</flow>

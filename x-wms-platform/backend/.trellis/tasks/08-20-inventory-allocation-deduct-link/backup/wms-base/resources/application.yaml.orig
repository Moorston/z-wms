server:
  port: 8082
  servlet:
    context-path: /api
spring:
  application:
    name: wms-base
  profiles:
    active: dev
  cloud:
    nacos:
      discovery:
        server-addr: ${NACOS_ADDR:localhost:8848}
        namespace: wms
      config:
        server-addr: ${NACOS_ADDR:localhost:8848}
        namespace: wms
        file-extension: yaml
  datasource:
    type: com.alibaba.druid.pool.DruidDataSource
    driver-class-name: oracle.jdbc.OracleDriver
    url: jdbc:oracle:thin:@${ORACLE_HOST:localhost}:${ORACLE_PORT:1521}:${ORACLE_SID:ORCLPDB1}
    username: ${ORACLE_USER:wms_user}
    password: ${ORACLE_PWD:wms_password}
    druid:
      initial-size: 3
      max-active: 30
      min-idle: 3
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      database: 1
mybatis-plus:
  mapper-locations: classpath*:mapper/**/*.xml
  configuration:
    map-underscore-to-camel-case: true
  global-config:
    db-config:
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0
spring.threads.virtual.enabled: true
knife4j:
  enable: true

# PowerJob 分布式任务调度 Worker
powerjob:
  worker:
    enabled: true
    app-name: wms-base
    server-address: ${POWERJOB_SERVER:127.0.0.1:7700}
    protocol: AKKA
    port: 27778
    result-store-max-length: 4096
    max-result-length: 4096

# Resilience4j 限流降级熔断配置
resilience4j:
  circuitbreaker:
    configs:
      default:
        failure-rate-threshold: 50
        wait-duration-in-open-state: 30s
        sliding-window-size: 20
        minimum-number-of-calls: 10
    instances:
      locationService:
        base-config: default
      productService:
        base-config: default
      ownerService:
        base-config: default
  ratelimiter:
    instances:
      locationService:
        limit-for-period: 100
        limit-refresh-period: 1s
      productService:
        limit-for-period: 100
        limit-refresh-period: 1s
  timelimiter:
    instances:
      locationService:
        timeout-duration: 3s
      productService:
        timeout-duration: 3s
  setting:
    language: zh_cn
    enable-version: true
    enable-search: true
    home-custom-message: "X WMS 基础数据服务接口文档"

# SpringDoc OpenAPI配置
springdoc:
  api-docs:
    path: /v3/api-docs
    enabled: true
  swagger-ui:
    path: /swagger-ui.html
    enabled: true
    tags-sorter: alpha
    operations-sorter: alpha
  group-configs:
    - group: "数据字典"
      paths-to-match: /dict/**
      packages-to-scan: com.xwms.base.dict
    - group: "库位管理"
      paths-to-match: /location/**, /warehouse/**, /area/**
      packages-to-scan: com.xwms.base.location
    - group: "基础档案"
      paths-to-match: /product/**, /owner/**, /customer/**
      packages-to-scan: com.xwms.base.master
    - group: "规则引擎"
      paths-to-match: /rule/**
      packages-to-scan: com.xwms.base.rule
    - group: "系统管理"
      paths-to-match: /system/**, /user/**, /role/**
      packages-to-scan: com.xwms.base.system
    - group: "全部接口"
      paths-to-match: /**
      packages-to-scan: com.xwms.base

# 敏感信息加密配置
wms:
  crypto:
    enabled: true
    # 32字节密钥（256位），生产环境通过环境变量 WMS_CRYPTO_SECRET_KEY 覆盖
    secret-key: x-wms-platform-aes-256-key-2026!!

